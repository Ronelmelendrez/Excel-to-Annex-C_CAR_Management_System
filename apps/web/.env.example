# Web app environment (Vite).
# Copy this file to `.env.local` and fill in the values for your Supabase project.
# `.env.local` is git-ignored; never commit real keys.

# --- Required -------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Project API "anon"/"publishable" key. This key is shipped to the browser,
# so it is public by design. Access is enforced by Row Level Security.
# NEVER put the service_role/secret key here.
VITE_SUPABASE_ANON_KEY=

# --- Optional -------------------------------------------------------------
# Base URL of the Edge Functions API.
# Leave empty to derive it from VITE_SUPABASE_URL:
#   <VITE_SUPABASE_URL>/functions/v1
# Set it only when the API is served from a different origin (for example a
# local proxy or a staging gateway).
VITE_API_BASE=
