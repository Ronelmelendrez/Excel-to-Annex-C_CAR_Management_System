# Edge Functions environment (local serving only).
# Copy to `supabase/functions/.env` when running `supabase functions serve`.
# Deployed functions receive these values automatically; do not commit real keys.

# Local stack URL from `supabase status` (or your hosted project URL).
SUPABASE_URL=http://127.0.0.1:54321

# Local anon key from `supabase status`.
SUPABASE_ANON_KEY=

# Local service_role key from `supabase status`.
# Server-only: bypasses Row Level Security. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
